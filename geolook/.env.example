# 引擎密钥只放本文件，部署时填一次。客户自助站（geo.py online）没有 Key 表单。
# 顾问看板设置里填写也会写入这里，效果相同。
# 一个都不填也能跑：自动采样会跳过，无 API 引擎走人工采样表 / 插件回传。

# ---- 国内引擎 CN engines ----
ZHIPUAI_API_KEY=
ARK_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=

# ---- 海外引擎 Global engines ----
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=

# 可选：覆盖各引擎默认采样模型 Optional model overrides
# GLM_MODEL=  ARK_MODEL=  DEEPSEEK_MODEL=  MOONSHOT_MODEL=  MINIMAX_MODEL=
# GEMINI_MODEL=  OPENAI_MODEL=  ANTHROPIC_MODEL=  GROK_MODEL=  PERPLEXITY_MODEL=

# ---- 发布渠道（可选）Publishing channels, optional ----
GITHUB_TOKEN=
WP_USER=
WP_APP_PASSWORD=
WECHAT_APPID=
WECHAT_APPSECRET=
PUBLISH_WEBHOOK_URL=
